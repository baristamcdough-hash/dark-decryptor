# ── PoriotCloud Vault · Railway env ─────────────────────────────────────────
# Public base URL (your custom domain, no trailing slash).
# HTTPS is automatic on Railway — a bare domain is treated as https://.
VAULT_PUBLIC_URL=https://vault.poriot.ke

# Force http→https redirect even if VAULT_PUBLIC_URL has no https:// scheme
FORCE_HTTPS=0

# Shared secret between the Telegram bot and the vault server (long + random!)
VAULT_API_TOKEN=change-me-to-a-long-random-string

# Admin panel password
VAULT_ADMIN_PASSWORD=change-me-admin

# Session signing secret (optional — random per boot if empty)
VAULT_SECRET=

# Vault lifetime in hours (auto-destroy)
VAULT_TTL_HOURS=6

# Telegram bot token (set it and the bot runs inside the same service)
BOT_TOKEN=

# The bot needs to reach the vault server:
#   same service → leave empty (bot posts to its own /api/vault via public URL)
#   or point it at the public URL explicitly:
VAULT_API_URL=
